# Copie para .env.local e preencha com os valores do projeto urna-dev.
# Painel: Settings > API  e  Settings > API Keys
#
# .env.local NUNCA vai para o repositório (já está no .gitignore).

# Públicas — vão para o navegador
NEXT_PUBLIC_SUPABASE_URL=https://pboemlfmgdwnktihiiyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredos — nunca saem do servidor
# Se o painel mostrar "Secret key" (sb_secret_...) em vez de service_role, use ela aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Etapa 2 (terminais e Realtime). Deixe em branco por enquanto.
SUPABASE_JWT_SECRET=
TERMINAL_TOKEN_PEPPER=
